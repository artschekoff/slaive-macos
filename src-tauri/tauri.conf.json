{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slaive",
  "version": "0.5.1",
  "identifier": "net.slaive.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "overlay",
        "url": "index.html",
        "title": "Slaive",
        "width": 440,
        "height": 252,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "settings",
        "url": "index.html",
        "title": "Slaive Settings",
        "width": 760,
        "height": 600,
        "minWidth": 680,
        "minHeight": 520,
        "resizable": true,
        "visible": false
      },
      {
        "label": "setup",
        "url": "index.html",
        "title": "Slaive Setup",
        "width": 560,
        "height": 620,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "visible": false
      },
      {
        "label": "main",
        "url": "index.html",
        "title": "Slaive",
        "width": 720,
        "height": 560,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "category": "Utility"
  }
}
