{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slaive",
  "version": "0.1.0",
  "identifier": "net.slaive.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "overlay",
        "url": "index.html",
        "title": "Slaive",
        "width": 440,
        "height": 240,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "settings",
        "url": "index.html",
        "title": "Slaive Settings",
        "width": 560,
        "height": 480,
        "resizable": false,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
